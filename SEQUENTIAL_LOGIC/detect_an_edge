


## Problem: Detect a Rising Edge

**Question:** Detect a 0-to-1 transition for each bit of an 8-bit input vector.

**HDLBits Question:** (https://hdlbits.01xz.net/wiki/Edgedetect)

**Solution:** `top_module.v`

**Concepts learned:**
- Positive edge detection
- Clocked `always` blocks
- Non-blocking assignments (`<=`)
- Storing the previous input using a register

module top_module (
    input clk,
    input [7:0] in,
    output [7:0] pedge
);
    int i;
    reg [7:0]in_past=8'b00000000;
    always @(posedge clk)
        
        begin
            pedge<=0;
             in_past<=in;//here non blocking assignment which evalaute the rhs immediately but update in nba region 
             //because of which inside for loop in will  have present input while in_past will have previous output 
             //if in_past is 00000010
                          // 00001110 so here the 3rd and 4th bit is changing from 0 to 1 
                            //so the output should be 00001100 which is 12 in decimal 
            for (i=0;i<8;i=i+1)
                begin
                    if(in_past[i]==0&&in[i]==1)
                        begin
                        pedge[i]<=1'b1;
                   
                        end
                    else 
                        pedge[i]<=0;
          
                end
        end
               

endmodule
