0 to 9 it already count 100 times now these 100 combination combine with another 0 to 9 combination so it become 1000 and the second enable pin should active 
once the w[3:0] comes to 9 similarly the 3rd  enable bit should  high when w[7:4 will be at 9 means 1001 and w[3:0 ]also at 1001 ]

module top_module (
    input clk,
    input reset,
    output OneHertz,
    output [2:0] c_enable
); 
    wire [11:0]w;
    assign c_enable[0]=1'b1;
    assign c_enable[1]=(w[3:0]==4'd9);
    assign c_enable[2]=(w[3:0]==4'd9 && w[7:4]==4'd9);
                
        

    bcdcount counter0 (clk, reset, c_enable[0],w[3:0]);
    bcdcount counter1 (clk, reset, c_enable[1],w[7:4]);
    bcdcount counter2 (clk, reset, c_enable[2],w[11:8]);
    assign OneHertz=(w[11:8]==4'd9 && w[7:4]==4'd9&& w[3:0]==4'd9)?1'b1:1'b0;

endmodule
